{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "760px", "wideSize": "1120px" },
    "color": { "palette": [
      { "slug": "ink", "name": "墨", "color": "#292d28" },
      { "slug": "paper", "name": "生成り", "color": "#f8f7f2" },
      { "slug": "autumn", "name": "紅葉", "color": "#9c452b" },
      { "slug": "spring", "name": "桜", "color": "#9e4962" },
      { "slug": "summer", "name": "新緑", "color": "#28625e" },
      { "slug": "winter", "name": "冬空", "color": "#385c76" }
    ] },
    "typography": { "fluid": true, "fontFamilies": [
      { "slug": "sans", "name": "読みやすいゴシック", "fontFamily": "-apple-system, BlinkMacSystemFont, 'Hiragino Kaku Gothic ProN', 'Yu Gothic', Meiryo, sans-serif" },
      { "slug": "serif", "name": "上品な明朝", "fontFamily": "'Yu Mincho', 'Hiragino Mincho ProN', 'Noto Serif CJK JP', serif" }
    ], "fontSizes": [
      { "slug": "small", "size": "0.875rem", "name": "小" },
      { "slug": "medium", "size": "1.0625rem", "name": "標準" },
      { "slug": "large", "size": "1.625rem", "name": "大" },
      { "slug": "x-large", "size": "2.25rem", "name": "特大" }
    ] },
    "spacing": { "units": ["px", "rem", "%", "vw"], "blockGap": "1.6rem" }
  },
  "styles": {
    "color": { "background": "#f8f7f2", "text": "#292d28" },
    "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "1.0625rem", "lineHeight": "1.95" },
    "elements": {
      "heading": { "typography": { "fontFamily": "var:preset|font-family|serif", "lineHeight": "1.6" } },
      "link": { "color": { "text": "#87422e" } }
    }
  }
}
